{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/_/backend",
      "framework": "nestjs",
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/_/backend/internal/cron/pending-reminder", "schedule": "30 12 * * *" },
    { "path": "/_/backend/internal/cron/daily-report", "schedule": "30 17 * * *" },
    { "path": "/_/backend/internal/cron/weekly-summary", "schedule": "30 2 * * 1" },
    { "path": "/_/backend/internal/cron/monthly-summary", "schedule": "30 2 1 * *" }
  ]
}
