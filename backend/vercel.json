{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "nest build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [
    { "path": "/internal/cron/pending-reminder", "schedule": "30 12 * * *" },
    { "path": "/internal/cron/daily-report", "schedule": "30 17 * * *" },
    { "path": "/internal/cron/weekly-summary", "schedule": "30 2 * * 1" },
    { "path": "/internal/cron/monthly-summary", "schedule": "30 2 1 * *" }
  ]
}
