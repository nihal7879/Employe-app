# App
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=employee_app

# JWT
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Employee App <no-reply@example.com>"
ADMIN_EMAIL=admin@example.com

# Scheduler timezone
TZ=Asia/Kolkata
