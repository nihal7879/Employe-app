# Copy to .env and fill in. Never commit .env.

# App
PORT=4000
NODE_ENV=development
# Comma-separated list allowed (e.g. local + deployed frontend)
FRONTEND_URL=http://localhost:5173

# Database (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=employee_app

# JWT - use a long random value (e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRES_IN=7d
# AES-256-GCM key for Gmail tokens at rest. Keep stable once set.
TOKEN_ENC_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Employee App <no-reply@example.com>"
ADMIN_EMAIL=

# Business rules (fallbacks when runtime-config.json is absent)
LOGIN_GRACE_MINUTES=120
DAY_START_EARLIEST=08:00:00
DAY_START_LATEST=23:59:59
BACKDATE_MAX_DAYS=7
MAX_TASK_HOURS=1.5
GPS_BACKFILL_WINDOW_MINUTES=10
# Shared Google logins -> employee IDs (JSON), e.g. {"shared@example.com":[1,2]}
SHARED_LOGINS={}

# Scheduler timezone
APP_TZ=Asia/Kolkata

# Shared secret for Vercel Cron HTTP triggers
CRON_SECRET=
